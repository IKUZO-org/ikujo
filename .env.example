# 이 파일을 .env.local 로 복사하고 값을 채운다. 값은 커밋하지 않는다 (SECURITY.md §1)
# Supabase 대시보드 → Project Settings → API

# 브라우저에 가도 되는 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버만. NEXT_PUBLIC_ 을 붙이지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# AI 배정 모델 이름 (spec §9, OQ-003 미정). 비워 두면 규칙 배정만 쓴다. 키 이름은 OQ-003 결정 뒤에 추가
LLM_MODEL=
